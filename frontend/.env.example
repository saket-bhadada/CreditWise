# Copy to .env (or .env.local) to override. None of these are secrets - Vite exposes
# every VITE_* variable to the browser, so never put credentials here.

# Base URL of the CreditWise API. Both the Node gateway (port 5000) and the FastAPI
# service (port 8000) expose the same /api/* routes.
#   Default (recommended for dev): "/api"  -> proxied by Vite to VITE_PROXY_TARGET
#   Production example:            https://api.example.com/api
VITE_API_BASE_URL=/api

# Dev/preview proxy target (only used by `npm run dev` / `npm run preview`).
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Per-request timeout in milliseconds (default 20000).
VITE_API_TIMEOUT_MS=20000
